{
  "name": "aidatasignal",
  "version": "0.1.0",
  "private": true,
  "description": "Root package so Cloudflare Workers Builds can install worker dependencies. The Worker (and its single-source-of-truth wrangler.toml) lives in apps/worker/.",
  "scripts": {
    "deploy": "cd apps/worker && npx wrangler deploy",
    "deploy:dry-run": "cd apps/worker && npx wrangler deploy --dry-run",
    "typecheck": "cd apps/worker && npm run typecheck"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.12.25",
    "pdfjs-dist": "^4.10.38",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.91.0"
  }
}
