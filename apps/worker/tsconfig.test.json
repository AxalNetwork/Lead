    "outDir": "test-dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/scraper/parsers/profile.ts",
